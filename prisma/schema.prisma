generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  company      Company?
}

model Company {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  razaoSocial    String
  cnpj           String
  logradouro     String
  numero         String
  complemento    String?
  bairro         String
  cidade         String
  uf             String
  cep            String

  banco          String
  agencia        String
  conta          String

  socioNome      String
  socioCpf       String

  logoUrl        String?

  objetoSocial   String
  atendeServico  Boolean   @default(true)
  atendeBem      Boolean   @default(true)
  keywords       Keyword[]
  editais        Edital[]
  editaisExcluidos EditalExcluido[]
  estudosViabilidade EstudoViabilidade[]

  // Regime tributário padrão da empresa — só pré-preenche um novo estudo (Etapa 3);
  // cada estudo pode sobrescrever para simulações, sem alterar este cadastro.
  regimeTributarioPadrao RegimeTributario?
  anexoSimplesPadrao     AnexoSimples?
  rbt12Padrao            Float?
  faixasSimples          FaixaSimplesNacional[]
  parametrosRegime       ParametroTributarioRegime[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Keyword {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  term       String
  createdAt  DateTime @default(now())

  @@unique([companyId, term])
}

enum EditalStatus {
  NOVO
  APROVADO
  REPROVADO
}

// Etapas do quadro Kanban da aba de editais — mais granulares que o EditalStatus
// (que continua existindo só para decidir quando disparar o pipeline de agentes).
// Ordem deliberada, igual ao quadro de referência do usuário.
enum EtapaKanban {
  OPORTUNIDADE
  QUALIFICACAO
  SEM_PROPOSTAS
  PRONTA_PARA_ENVIAR
  ENVIADA_PARA_DISPUTA
  CLASSIFICACAO
  ELIMINADA_APOS_CLASSIFICACAO
  ACEITA
  RECUSADA_DESCLASSIFICADA
  EM_CONTRATO
  FINALIZADA
  RASCUNHO
}

model Edital {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fonte               String        @default("PNCP")
  numeroControlePNCP  String
  titulo              String
  descricao           String
  orgaoNome           String
  orgaoCnpj           String
  municipio           String?
  uf                  String?
  modalidade          String?
  situacao            String?
  dataPublicacao      DateTime?
  dataAtualizacaoPncp DateTime?
  dataAberturaProposta DateTime?
  dataEncerramentoProposta DateTime?
  valorGlobal         Float?
  orcamentoSigiloso   Boolean       @default(false)
  tipoObjeto          String?
  linkPortal           String
  keywordMatched      String?

  status              EditalStatus  @default(NOVO)
  decidedAt           DateTime?

  // Quadro Kanban: etapa/coluna, posição de arraste dentro da coluna, cor do card
  // (etiqueta livre, estilo Trello) e anotações internas do usuário sobre o card.
  etapaKanban         EtapaKanban   @default(OPORTUNIDADE)
  ordemKanban         Float         @default(0)
  corCard             String?
  notasInternas       String?

  analysis            Analysis?
  proposal            Proposal?
  documents           Document[]
  checklistItems      ChecklistItem[]
  auditLogs           AuditLog[]
  agentRuns           AgentRun[]
  agentMessages       AgentMessage[]
  estudosViabilidade  EstudoViabilidade[]

  createdAt           DateTime      @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([companyId, numeroControlePNCP])
}

// Chat de correção por agente: cada aba de agente (Análise, Financeiro, Documentos,
// Checklist, Auditoria) tem sua própria conversa isolada com o respectivo agente,
// identificada por agentKey (mesma chave usada em AgentRun/AuditLog).
model AgentMessage {
  id         String   @id @default(cuid())
  editalId   String
  edital     Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)
  agentKey   String
  role       String   // "user" | "agent"
  conteudo   String
  anexoNome  String?
  anexoDocId String?
  createdAt  DateTime @default(now())

  @@index([editalId, agentKey])
}

// Registro de "já visto" — mantém a chave PNCP de um edital excluído pelo usuário para
// o Agente Comercial nunca mais recapturá-lo numa busca futura (o card em si já foi
// apagado, então a checagem de duplicidade normal, que olha os editais existentes, não
// enxerga mais essa chave sem este registro à parte).
model EditalExcluido {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numeroControlePNCP String
  excluidoEm         DateTime @default(now())

  @@unique([companyId, numeroControlePNCP])
}

model Analysis {
  id                    String   @id @default(cuid())
  editalId              String   @unique
  edital                Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)

  resumoObjeto          String
  obrigacoesContratada  String
  habilitacao           String
  requisitosObrigatorios String
  requisitosAdicionais  String
  riscos                String
  parecer               String
  baseadoEmTextoCompleto Boolean @default(false)

  createdAt             DateTime @default(now())
}

model Proposal {
  id                    String   @id @default(cuid())
  editalId              String   @unique
  edital                Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)

  valorGlobalReferencia Float
  itensJson             String
  observacoes           String?
  descontoPercentual    Float    @default(0)
  baseadoEmTextoCompleto Boolean @default(false)

  createdAt             DateTime @default(now())
}

enum DocumentTipo {
  ANEXO_GERADO
  DOCUMENTO_USUARIO
  DOCUMENTO_PNCP
}

enum DocumentStatus {
  PENDENTE
  GERADO
  ENVIADO
  VENCIDO
  DISPONIVEL
}

model Document {
  id               String         @id @default(cuid())
  editalId         String
  edital           Edital         @relation(fields: [editalId], references: [id], onDelete: Cascade)

  nome             String
  tipo             DocumentTipo
  categoria        String?
  status           DocumentStatus @default(PENDENTE)
  conteudoBase64   String?
  origemUrl        String?
  // Texto do PDF extraído uma única vez e reaproveitado pelos agentes Analista,
  // Financeiro e Advogado — evita reprocessar o mesmo PDF 3x por edital.
  textoExtraido    String?
  validade         DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum ChecklistStatus {
  FALTANTE
  ENVIADO
  VENCIDO
  OK
}

model ChecklistItem {
  id            String          @id @default(cuid())
  editalId      String
  edital        Edital          @relation(fields: [editalId], references: [id], onDelete: Cascade)

  documentoNome String
  obrigatorio   Boolean         @default(true)
  status        ChecklistStatus @default(FALTANTE)
  validade      DateTime?
  observacao    String?
  anexoDocId    String?
  anexoNome     String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum AuditSeverity {
  OK
  ALERTA
  ERRO
}

model AuditLog {
  id          String        @id @default(cuid())
  editalId    String
  edital      Edital        @relation(fields: [editalId], references: [id], onDelete: Cascade)

  agente      String
  etapa       String
  severidade  AuditSeverity
  mensagem    String
  acaoTomada  String?

  createdAt   DateTime      @default(now())
}

enum AgentRunStatus {
  RUNNING
  DONE
  ERROR
}

model AgentRun {
  id          String         @id @default(cuid())
  editalId    String
  edital      Edital         @relation(fields: [editalId], references: [id], onDelete: Cascade)

  agentKey    String
  status      AgentRunStatus @default(RUNNING)
  message     String?

  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
}

// ── Estudo de Viabilidade ───────────────────────────────────────────────────
// Módulo de precificação/decisão de participação em licitação, independente do
// quadro Kanban de editais — cada estudo é um cálculo (potencialmente uma
// simulação, não necessariamente ligado a um edital já capturado no sistema).

enum RamoEstudo {
  SERVICO
  PRODUTO
}

model EstudoViabilidade {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ramo      RamoEstudo

  // Etapa 1: edital de referência do estudo (opcional — nulo enquanto não escolhido, e
  // pode ficar nulo se o edital de origem for excluído depois, sem apagar o estudo).
  editalId  String?
  edital    Edital?    @relation(fields: [editalId], references: [id], onDelete: SetNull)

  // Etapa 2: requisitos extraídos via IA (JSON.stringify de RequisitosEstudo — mesmo
  // padrão de string JSON usado em Analysis/Proposal, não um tipo Json nativo).
  // requisitosConfirmadoEm só é gravado quando o usuário revisa e confirma manualmente
  // (nunca avança sozinho) — é isso, e não a mera presença do JSON, que marca a etapa
  // como concluída.
  requisitosJson         String?
  requisitosConfirmadoEm DateTime?

  // Etapa 3: regime tributário escolhido para ESTE estudo (pode divergir do padrão
  // cadastrado da empresa — é uma simulação). aliquotasJson é o resultado já resolvido
  // (snapshot) das alíquotas no momento da confirmação — o cálculo (Etapa 5) lê daqui,
  // nunca direto da tabela de parâmetros, para não mudar um estudo já confirmado se a
  // empresa atualizar os parâmetros depois (auditabilidade).
  regimeTributario     RegimeTributario?
  anexoSimples         AnexoSimples?
  rbt12                Float?
  aliquotasJson        String?
  tributosConfirmadoEm DateTime?

  // Etapa 4: custos por item/lote. itensSnapshotJson congela a lista de itens (copiada
  // de edital.proposal.itensJson) no momento em que a etapa começa — dá uma referência
  // estável para CustoItemEstudo.itemIndex, mesmo que a Proposal do edital seja
  // reprocessada depois. parametrosCustoJson guarda os valores usados pelo botão
  // "aplicar a todos" (não são obrigatórios, só uma conveniência de preenchimento).
  itensSnapshotJson    String?
  parametrosCustoJson  String?
  custosConfirmadoEm   DateTime?
  custosItens          CustoItemEstudo[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Custos informados pelo usuário para UM item/lote do estudo — todos os campos
// (diretos e percentuais de BDI/margem) ficam num JSON só, com o formato variando por
// ramo (ver CustoItemServico/CustoItemProduto em src/lib/estudo-custos.ts), seguindo o
// mesmo padrão de string JSON usado no resto do módulo.
model CustoItemEstudo {
  id         String            @id @default(cuid())
  estudoId   String
  estudo     EstudoViabilidade @relation(fields: [estudoId], references: [id], onDelete: Cascade)

  itemIndex  Int
  custosJson String

  updatedAt  DateTime          @updatedAt

  @@unique([estudoId, itemIndex])
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum AnexoSimples {
  I
  III
  IV
  V
}

// Tabela do Simples Nacional (LC 123/2006) — por empresa e editável (tela de parâmetros
// tributários), nunca fixa no código. Uma linha por Anexo × Faixa de RBT12.
model FaixaSimplesNacional {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  anexo           AnexoSimples
  faixa           Int
  rbt12Min        Float
  rbt12Max        Float
  aliquotaNominal Float
  parcelaDeduzir  Float

  updatedAt       DateTime     @updatedAt

  @@unique([companyId, anexo, faixa])
}

// Alíquotas efetivas sobre a receita para Lucro Presumido/Real — uma linha por
// regime × ramo (ISS para serviço, ICMS para produto). Também editável, nunca fixa.
model ParametroTributarioRegime {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  regime    RegimeTributario
  ramo      RamoEstudo
  issOuIcms Float
  pis       Float
  cofins    Float
  irpjCsll  Float

  updatedAt DateTime         @updatedAt

  @@unique([companyId, regime, ramo])
}
