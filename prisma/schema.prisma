generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  company      Company?
}

model Company {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  razaoSocial String
  cnpj        String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  cep         String

  banco   String
  agencia String
  conta   String

  socioNome String
  socioCpf  String

  logoUrl String?

  objetoSocial  String
  atendeServico Boolean   @default(true)
  atendeBem     Boolean   @default(true)
  keywords      Keyword[]

  // Segmento da LicitaNet (https://licitanet.com.br) usado pelo Agente Comercial para
  // buscar também nesse portal, além do PNCP — id/nome vêm da tabela fixa de segmentos
  // do próprio site (src/lib/licitanet-segmentos.ts), não é uma taxonomia nossa.
  licitanetSegmentoId   Int?
  licitanetSegmentoNome String?

  // Número de WhatsApp para notificações (formato E.164 sem "+", ex: 5511999999999) —
  // usado pela busca agendada (novos editais) e pelos alertas de prazo do checklist.
  whatsapp String?

  editais            Edital[]
  editaisExcluidos   EditalExcluido[]
  estudosViabilidade EstudoViabilidade[]
  // Dossiê de documentos reutilizáveis da empresa (certidões, contrato social...) — ver
  // CompanyDocument. O Agente Secretário usa isso pra preencher sozinho os itens padrão
  // do checklist de cada edital novo, sem o usuário reenviar o mesmo documento sempre.
  documentos         CompanyDocument[]

  // Regime tributário padrão da empresa — só pré-preenche um novo estudo (Etapa 3);
  // cada estudo pode sobrescrever para simulações, sem alterar este cadastro.
  regimeTributarioPadrao RegimeTributario?
  anexoSimplesPadrao     AnexoSimples?
  rbt12Padrao            Float?
  faixasSimples          FaixaSimplesNacional[]
  parametrosRegime       ParametroTributarioRegime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Keyword {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@unique([companyId, term])
}

enum EditalStatus {
  NOVO
  APROVADO
  REPROVADO
}

// Etapas do quadro Kanban da aba de editais — mais granulares que o EditalStatus
// (que continua existindo só para decidir quando disparar o pipeline de agentes).
// Ordem deliberada, igual ao quadro de referência do usuário.
enum EtapaKanban {
  OPORTUNIDADE
  QUALIFICACAO
  SEM_PROPOSTAS
  PRONTA_PARA_ENVIAR
  ENVIADA_PARA_DISPUTA
  CLASSIFICACAO
  ELIMINADA_APOS_CLASSIFICACAO
  ACEITA
  RECUSADA_DESCLASSIFICADA
  EM_CONTRATO
  FINALIZADA
  RASCUNHO
}

// Por que um card foi parar em "Rascunho" sem ação manual comum — usado só pra
// diferenciar visualmente os dois casos na coluna; null significa card ali por qualquer
// outro motivo (ex: captação manual em andamento, ou arrastado manualmente pra lá).
enum MotivoMovimentacao {
  INATIVIDADE
  EXCLUSAO_MANUAL
}

model Edital {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fonte                    String    @default("PNCP")
  numeroControlePNCP       String
  titulo                   String
  descricao                String
  orgaoNome                String
  orgaoCnpj                String
  municipio                String?
  uf                       String?
  modalidade               String?
  situacao                 String?
  dataPublicacao           DateTime?
  dataAtualizacaoPncp      DateTime?
  dataAberturaProposta     DateTime?
  dataEncerramentoProposta DateTime?
  valorGlobal              Float?
  orcamentoSigiloso        Boolean   @default(false)
  tipoObjeto               String?
  linkPortal               String
  keywordMatched           String?

  status    EditalStatus @default(NOVO)
  decidedAt DateTime?

  // Quadro Kanban: etapa/coluna, posição de arraste dentro da coluna, cor do card
  // (etiqueta livre, estilo Trello) e anotações internas do usuário sobre o card.
  etapaKanban   EtapaKanban @default(OPORTUNIDADE)
  ordemKanban   Float       @default(0)
  corCard       String?
  notasInternas String?

  // Ciclo de vida da coluna "Oportunidade": "visualizado" marca se o usuário já abriu o
  // card (reseta pra false se o órgão retificar o edital depois de já visto — ver
  // agente1-comercial.ts). "ultimaMovimentacao" é tocado por qualquer AÇÃO DO USUÁRIO
  // (não por execução automática de agente) e alimenta a expiração por inatividade de
  // 48h, verificada sob demanda em GET /api/editais (sem cron). "motivoMovimentacao"
  // só é setado quando o card vai pra Rascunho por inatividade ou exclusão — fica null
  // no caso normal, e é limpo de volta assim que o usuário arrasta o card manualmente
  // (isso já funciona como a "recuperação" de um card excluído, sem UI nova).
  visualizado        Boolean             @default(false)
  visualizadoEm      DateTime?
  ultimaMovimentacao DateTime            @default(now())
  motivoMovimentacao MotivoMovimentacao?
  movidoEm           DateTime?

  analysis           Analysis?
  proposal           Proposal?
  documents          Document[]
  checklistItems     ChecklistItem[]
  auditLogs          AuditLog[]
  agentRuns          AgentRun[]
  agentMessages      AgentMessage[]
  estudosViabilidade EstudoViabilidade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, numeroControlePNCP])
}

// Chat de correção por agente: cada aba de agente (Análise, Financeiro, Documentos,
// Checklist, Auditoria) tem sua própria conversa isolada com o respectivo agente,
// identificada por agentKey (mesma chave usada em AgentRun/AuditLog).
model AgentMessage {
  id         String   @id @default(cuid())
  editalId   String
  edital     Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)
  agentKey   String
  role       String // "user" | "agent"
  conteudo   String
  anexoNome  String?
  anexoDocId String?
  createdAt  DateTime @default(now())

  @@index([editalId, agentKey])
}

// Registro de "já visto" — mantém a chave PNCP de um edital excluído pelo usuário para
// o Agente Comercial nunca mais recapturá-lo numa busca futura (o card em si já foi
// apagado, então a checagem de duplicidade normal, que olha os editais existentes, não
// enxerga mais essa chave sem este registro à parte).
model EditalExcluido {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numeroControlePNCP String
  excluidoEm         DateTime @default(now())

  @@unique([companyId, numeroControlePNCP])
}

model Analysis {
  id       String @id @default(cuid())
  editalId String @unique
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  resumoObjeto           String
  obrigacoesContratada   String
  habilitacao            String
  requisitosObrigatorios String
  requisitosAdicionais   String
  riscos                 String
  parecer                String
  baseadoEmTextoCompleto Boolean @default(false)

  createdAt DateTime @default(now())
}

model Proposal {
  id       String @id @default(cuid())
  editalId String @unique
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  valorGlobalReferencia  Float
  itensJson              String
  observacoes            String?
  descontoPercentual     Float   @default(0)
  baseadoEmTextoCompleto Boolean @default(false)

  createdAt DateTime @default(now())
}

enum DocumentTipo {
  ANEXO_GERADO
  DOCUMENTO_USUARIO
  DOCUMENTO_PNCP
  DOCUMENTO_LICITANET
}

enum DocumentStatus {
  PENDENTE
  GERADO
  ENVIADO
  VENCIDO
  DISPONIVEL
}

model Document {
  id       String @id @default(cuid())
  editalId String
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  nome           String
  tipo           DocumentTipo
  categoria      String?
  status         DocumentStatus @default(PENDENTE)
  conteudoBase64 String?
  // Caminho no bucket "documentos-habilitacao" do Supabase Storage, pra anexos grandes
  // enviados direto do navegador (fora do corpo da requisição da função serverless, que
  // tem teto de ~4,5MB) — quando presente, o conteúdo mora no Storage, não na coluna
  // conteudoBase64 acima.
  storagePath    String?
  origemUrl      String?
  // Texto do PDF extraído uma única vez e reaproveitado pelos agentes Analista,
  // Financeiro e Advogado — evita reprocessar o mesmo PDF 3x por edital.
  textoExtraido  String?
  validade       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChecklistStatus {
  FALTANTE
  ENVIADO
  VENCIDO
  OK
}

// Categorias de habilitação/qualificação da Lei 14.133/2021 (Art. 62-70) — nomeadas e
// agrupadas para bater com a própria estrutura de seções que os editais reais usam (ex:
// "13.1 Regularidade Fiscal, Trabalhista, Econômico-Financeira e Jurídica" como UMA seção
// só, não três). Um item só recebe uma dessas quando o Agente Secretário consegue mapear
// com confiança a seção do edital de onde ele veio — caso contrário fica null e aparece
// agrupado como "Outros" na tela e no ZIP.
enum HabilitacaoCategoria {
  FISCAL_TRABALHISTA_ECONOMICO_FINANCEIRA_JURIDICA
  QUALIFICACAO_TECNICA_EMPRESA
  QUALIFICACAO_EQUIPE_TECNICA
  GARANTIA_CONTRATO
}

model ChecklistItem {
  id       String @id @default(cuid())
  editalId String
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  documentoNome String
  obrigatorio   Boolean               @default(true)
  status        ChecklistStatus       @default(FALTANTE)
  categoria     HabilitacaoCategoria?
  validade      DateTime?
  observacao    String?
  anexoDocId    String?
  anexoNome     String?

  // Data (sem hora) do último alerta de vencimento enviado por e-mail/WhatsApp para este
  // item — evita reenviar o mesmo aviso a cada execução do cron (8:30 e 15:30).
  ultimoAlertaEnviadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Forma exigida/apresentada do documento (cópia simples, autenticado em cartório,
// assinatura digital ICP-Brasil) — o sistema nunca decide sozinho se uma forma atende a
// exigência de um edital específico; só deixa isso visível para o usuário decidir.
enum FormaDocumento {
  COPIA_SIMPLES
  AUTENTICADO
  ASSINATURA_DIGITAL
}

// Dossiê da empresa: documentos reutilizáveis entre editais (certidões, contrato social,
// atestados...), independentes de qualquer licitação específica. O Agente Secretário casa
// automaticamente os itens padrão do checklist (ver CHECKLIST_BASE em
// agente5-secretario.ts) com o documento aqui de mesmo "tipo", verificando a validade
// antes de reaproveitar — evita reenviar a mesma certidão a cada edital novo.
model CompanyDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mesmo vocabulário de ChecklistItem.documentoNome — permite casar por igualdade de
  // string, sem depender de matching difuso por IA.
  tipo      String
  categoria HabilitacaoCategoria?

  nome        String
  forma       FormaDocumento @default(COPIA_SIMPLES)
  dataEmissao DateTime?
  // null = não vence (ex: Contrato Social, Cartão CNPJ).
  validade    DateTime?

  conteudoBase64 String?
  storagePath    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum AuditSeverity {
  OK
  ALERTA
  ERRO
}

model AuditLog {
  id       String @id @default(cuid())
  editalId String
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  agente     String
  etapa      String
  severidade AuditSeverity
  mensagem   String
  acaoTomada String?

  createdAt DateTime @default(now())
}

enum AgentRunStatus {
  RUNNING
  DONE
  ERROR
}

model AgentRun {
  id       String @id @default(cuid())
  editalId String
  edital   Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)

  agentKey String
  status   AgentRunStatus @default(RUNNING)
  message  String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ── Estudo de Viabilidade ───────────────────────────────────────────────────
// Módulo de precificação/decisão de participação em licitação, independente do
// quadro Kanban de editais — cada estudo é um cálculo (potencialmente uma
// simulação, não necessariamente ligado a um edital já capturado no sistema).

enum RamoEstudo {
  SERVICO
  PRODUTO
}

model EstudoViabilidade {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ramo RamoEstudo
  // Nome livre dado pelo usuário (ex: "HESA — Exames laboratoriais") — opcional; quando
  // nulo, a UI mostra o rótulo do ramo (RAMO_LABEL) como já fazia antes deste campo existir.
  nome String?

  // Etapa 1: edital de referência do estudo (opcional — nulo enquanto não escolhido, e
  // pode ficar nulo se o edital de origem for excluído depois, sem apagar o estudo).
  editalId String?
  edital   Edital? @relation(fields: [editalId], references: [id], onDelete: SetNull)

  // Etapa 2: requisitos extraídos via IA (JSON.stringify de RequisitosEstudo — mesmo
  // padrão de string JSON usado em Analysis/Proposal, não um tipo Json nativo).
  // requisitosConfirmadoEm só é gravado quando o usuário revisa e confirma manualmente
  // (nunca avança sozinho) — é isso, e não a mera presença do JSON, que marca a etapa
  // como concluída.
  requisitosJson         String?
  requisitosConfirmadoEm DateTime?

  // Etapa 3: regime tributário escolhido para ESTE estudo (pode divergir do padrão
  // cadastrado da empresa — é uma simulação). aliquotasJson é o resultado já resolvido
  // (snapshot) das alíquotas no momento da confirmação — o cálculo (Etapa 5) lê daqui,
  // nunca direto da tabela de parâmetros, para não mudar um estudo já confirmado se a
  // empresa atualizar os parâmetros depois (auditabilidade).
  regimeTributario     RegimeTributario?
  anexoSimples         AnexoSimples?
  rbt12                Float?
  aliquotasJson        String?
  tributosConfirmadoEm DateTime?

  // Etapa 4 (ramo Produto): custos por item/lote. itensSnapshotJson congela a lista de
  // itens (copiada de edital.proposal.itensJson) no momento em que a etapa começa — dá
  // uma referência estável para CustoItemEstudo.itemIndex, mesmo que a Proposal do
  // edital seja reprocessada depois. parametrosCustoJson guarda os valores usados pelo
  // botão "aplicar a todos" (não são obrigatórios, só uma conveniência de preenchimento).
  itensSnapshotJson   String?
  parametrosCustoJson String?
  custosItens         CustoItemEstudo[]

  // Etapa 4 (ramo Serviço): DRE mensal detalhada — cargosJson é sugerido por IA a partir
  // do texto do edital (extrairCargosServico) e depois editável pelo usuário; nenhuma
  // quantidade é assumida sem edital ou edição manual. custosOperacionaisJson é uma
  // lista livre de linhas nomeadas (aluguel, insumos etc.), sem campos fixos no schema.
  cargosJson             String?
  custosOperacionaisJson String?
  descontoPercentual     Float?
  duracaoContratoMeses   Int?

  // Compartilhado pelos dois ramos: só gravado quando o usuário revisa e confirma a
  // etapa manualmente (nunca avança sozinho).
  custosConfirmadoEm DateTime?

  // Etapa 5: motor de cálculo — puro/isolado em src/lib/calculo-viabilidade.ts, sem
  // nenhuma dependência de UI ou banco (recebe os dados já resolvidos e devolve o
  // resultado). resultadoCalculoJson é o snapshot completo (por item + consolidado +
  // sensibilidade + recomendação) gerado a partir dos dados confirmados nas etapas
  // anteriores — recalculado sob demanda, nunca editado à mão.
  margemMinimaAceitavel Float?
  resultadoCalculoJson  String?
  calculoConfirmadoEm   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Custos informados pelo usuário para UM item/lote do estudo — todos os campos
// (diretos e percentuais de BDI/margem) ficam num JSON só, com o formato variando por
// ramo (ver CustoItemServico/CustoItemProduto em src/lib/estudo-custos.ts), seguindo o
// mesmo padrão de string JSON usado no resto do módulo.
model CustoItemEstudo {
  id       String            @id @default(cuid())
  estudoId String
  estudo   EstudoViabilidade @relation(fields: [estudoId], references: [id], onDelete: Cascade)

  itemIndex  Int
  custosJson String

  updatedAt DateTime @updatedAt

  @@unique([estudoId, itemIndex])
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum AnexoSimples {
  I
  III
  IV
  V
}

// Tabela do Simples Nacional (LC 123/2006) — por empresa e editável (tela de parâmetros
// tributários), nunca fixa no código. Uma linha por Anexo × Faixa de RBT12.
model FaixaSimplesNacional {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  anexo           AnexoSimples
  faixa           Int
  rbt12Min        Float
  rbt12Max        Float
  aliquotaNominal Float
  parcelaDeduzir  Float

  updatedAt DateTime @updatedAt

  @@unique([companyId, anexo, faixa])
}

// Alíquotas efetivas sobre a receita para Lucro Presumido/Real — uma linha por
// regime × ramo (ISS para serviço, ICMS para produto). Também editável, nunca fixa.
model ParametroTributarioRegime {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  regime    RegimeTributario
  ramo      RamoEstudo
  issOuIcms Float
  pis       Float
  cofins    Float
  irpjCsll  Float

  // Base de presunção do IRPJ usada só para o adicional de 10% sobre o excedente mensal
  // de R$20.000 (RIR/2018, art. 606) — opcional; nulo = adicional não calculado (nenhuma
  // suposição de atividade/base é feita sem o usuário configurar).
  baseCalculoPresumidoPercentual Float?

  updatedAt DateTime @updatedAt

  @@unique([companyId, regime, ramo])
}
