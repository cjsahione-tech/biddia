DATABASE_URL="postgresql://user:password@host:5432/postgres"
JWT_SECRET="gere com: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ANTHROPIC_API_KEY="sk-ant-..."

# Supabase Storage — upload de anexos grandes do checklist direto do navegador (evita o
# teto de ~4,5MB de corpo de requisição das funções serverless da Vercel). Chave anon
# normal do projeto Supabase; a política de acesso do bucket "documentos-habilitacao" já
# está restrita só a ele.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="..."

# Busca agendada e alertas de prazo (src/app/api/cron/*) — protege as rotas de cron
# contra chamadas públicas. Gere com o mesmo comando do JWT_SECRET acima.
CRON_SECRET="..."

# E-mail transacional (Resend) — usado pelas notificações de novos editais e prazos.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Bidd.IA <notificacoes@seudominio.com.br>"

# WhatsApp Cloud API (Meta) — mesma finalidade, canal WhatsApp.
WHATSAPP_CLOUD_API_TOKEN="..."
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID="..."
WHATSAPP_TEMPLATE_NOVOS_EDITAIS="bidd_novos_editais"
WHATSAPP_TEMPLATE_PRAZO_VENCENDO="bidd_prazo_vencendo"

# Twilio (SMS) — usado só pelo link de redefinição de senha (WhatsApp Cloud API acima
# não serve pra isso: só envia template pré-aprovado pela Meta, não texto livre com link).
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+15550001234"

NEXT_PUBLIC_APP_URL="https://licitax.vercel.app"
